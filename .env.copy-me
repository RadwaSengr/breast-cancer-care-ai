# انسخي هذا الملف باسم .env داخل نفس مجلد المشروع
# لا ترفعي ملف .env إلى GitHub

# رابط Supabase PostgreSQL - لا تضعي أقواسًا حول كلمة المرور
# إذا احتوت كلمة المرور على رموز خاصة، استخدمي URL encoding.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ضعي قيمة عشوائية طويلة، ويمكن توليدها بالأمر: openssl rand -base64 32
JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE

# إعداد الذكاء الاصطناعي
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=PUT_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# إعدادات اختيارية - اتركيها فارغة إذا كنت تريدين تشغيل الشات الأساسي فقط
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

PORT=3000
