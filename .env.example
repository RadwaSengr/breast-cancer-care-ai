# Copy this file to .env and fill in values locally. Never commit .env.

# Required for chat persistence and RAG. Supabase PostgreSQL with pgvector.
# Do not include square brackets around the password. URL-encode special characters.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Required for signed session cookies.
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI-compatible LLM endpoint. OpenAI uses https://api.openai.com.
# For Manus Forge, use the Forge URL and key supplied by Manus instead.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace-with-your-key

# Optional Manus OAuth/admin and storage integration for the /rag admin flow.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional public map proxy used by the map component.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

PORT=3000
